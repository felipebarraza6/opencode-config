# Dependencias y manifiestos generados por OpenCode al instalar plugins.
# Se recrean solos en el equipo nuevo; las versiones van fijadas en opencode.jsonc.
node_modules/
package.json
package-lock.json
bun.lock

# Secretos y estado local de esta máquina. NUNCA versionar.
service.json

# Estado de decisiones del instalador de LSP (propio de cada equipo).
lsp-install-decisions.json

# Basura
*.bak
*.bak-*
*.log
.DS_Store
