{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  // Dynamic Context Pruning — reduce tokens sin borrar el historial real.
  "enabled": true,
  "autoUpdate": false,
  "debug": false,
  "pruneNotification": "minimal",
  "pruneNotificationType": "toast",
  "commands": {
    "enabled": true,
    // V2 usa "subagent" en vez de "task"; se retira "call_omo_agent" (OMO eliminado).
    "protectedTools": ["subagent", "skill"]
  },
  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  }
}
